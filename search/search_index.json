{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u8425\u4e1a\u6267\u7167\u5236\u4f5c\u65b9\u6cd5\uff0c\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u4ee3\u529e\u65b9\u5f0f","text":"<p>\u5728\u521b\u4e1a\u6216\u62d3\u5c55\u4e1a\u52a1\u7684\u8fc7\u7a0b\u4e2d\uff0c\u8425\u4e1a\u6267\u7167\u662f\u4f01\u4e1a\u8fdb\u5165\u5e02\u573a\u7684\u5408\u6cd5\u901a\u884c\u8bc1\u3002\u65e0\u8bba\u662f\u5f00\u4e00\u5bb6\u8857\u8fb9\u5c0f\u5e97\uff0c\u8fd8\u662f\u6210\u7acb\u4e00\u5bb6\u5927\u578b\u96c6\u56e2\u516c\u53f8\uff0c\u4f9d\u6cd5\u53d6\u5f97\u8425\u4e1a\u6267\u7167\u90fd\u662f\u5fc5\u987b\u5c65\u884c\u7684\u6cd5\u5b9a\u7a0b\u5e8f\u3002\u8bb8\u591a\u521d\u521b\u8005\u5728\u9762\u5bf9\u590d\u6742\u7684\u5ba1\u6279\u6d41\u7a0b\u65f6\uff0c\u5f80\u5f80\u4f1a\u5173\u6ce8\u5b98\u65b9\u7684\u8425\u4e1a\u6267\u7167\u5236\u4f5c\u65b9\u6cd5\uff0c\u6216\u8005\u9009\u62e9\u66f4\u52a0\u9ad8\u6548\u7684\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u4ee3\u529e\u65b9\u5f0f\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u5168\u9762\u89e3\u6790\u8425\u4e1a\u6267\u7167\u7684\u5b98\u65b9\u8bbe\u7acb\u767b\u8bb0\u6d41\u7a0b\u3001\u771f\u4f2a\u8fa8\u522b\u7279\u5f81\uff0c\u4ee5\u53ca\u5982\u4f55\u5408\u89c4\u9009\u62e9\u4ee3\u529e\u670d\u52a1\uff0c\u5e2e\u52a9\u60a8\u7684\u4f01\u4e1a\u5feb\u901f\u3001\u5408\u6cd5\u5730\u4e0a\u7ebf\u8fd0\u8425\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u5b98\u65b9\u8425\u4e1a\u6267\u7167\u5236\u4f5c\u65b9\u6cd5\u4e0e\u8bbe\u7acb\u6d41\u7a0b","text":"<p>\u6211\u56fd\u7684\u8425\u4e1a\u6267\u7167\u662f\u7531\u5e02\u573a\u76d1\u7763\u7ba1\u7406\u5c40\u4f9d\u6cd5\u7edf\u4e00\u76d1\u5236\u5e76\u9881\u53d1\u7684\u3002\u4f01\u4e1a\u65e0\u6cd5\u81ea\u884c\u201c\u5236\u4f5c\u201d\uff0c\u5fc5\u987b\u901a\u8fc7\u6cd5\u5b9a\u7684\u201c\u8bbe\u7acb\u767b\u8bb0\u201d\u7a0b\u5e8f\uff0c\u7531\u5b98\u65b9\u7cfb\u7edf\u6838\u53d1\u3002\u6807\u51c6\u7684\u5b98\u65b9\u7533\u9886\u6d41\u7a0b\u5982\u4e0b\uff1a</p>"},{"location":"#1","title":"1. \u4f01\u4e1a\u540d\u79f0\u9884\u5148\u6838\u51c6","text":"<p>\u521b\u4e1a\u8005\u9700\u8981\u786e\u5b9a\u516c\u53f8\u7c7b\u578b\u3001\u540d\u5b57\u3001\u6ce8\u518c\u8d44\u672c\u3001\u80a1\u4e1c\u53ca\u51fa\u8d44\u6bd4\u4f8b\uff0c\u5e76\u901a\u8fc7\u5b98\u65b9\u7684\u653f\u52a1\u670d\u52a1\u7f51\u6216\u201c\u56fd\u5bb6\u4f01\u4e1a\u4fe1\u7528\u4fe1\u606f\u516c\u793a\u7cfb\u7edf\u201d\u63d0\u4ea4\u540d\u79f0\u6838\u51c6\u7533\u8bf7\u3002</p>"},{"location":"#2","title":"2. \u63d0\u4ea4\u767b\u8bb0\u7533\u8bf7\u6750\u6599","text":"<p>\u540d\u79f0\u901a\u8fc7\u540e\uff0c\u9700\u8981\u5728\u7ebf\u4e0a\uff08\u5982\u4e00\u7f51\u901a\u529e\u5e73\u53f0\uff09\u6216\u7ebf\u4e0b\u7a97\u53e3\u63d0\u4ea4\u4ee5\u4e0b\u6838\u5fc3\u8bbe\u7acb\u6750\u6599\uff1a *   \u516c\u53f8\u6cd5\u5b9a\u4ee3\u8868\u4eba\u3001\u80a1\u4e1c\u3001\u76d1\u4e8b\u7684\u8eab\u4efd\u8bc1\u660e\u3002 *   \u516c\u53f8\u7ae0\u7a0b\u3001\u80a1\u4e1c\u4f1a\u51b3\u8bae\u3002 *   \u4f4f\u6240\u4f7f\u7528\u8bc1\u660e\uff08\u5982\u623f\u5c4b\u79df\u8d41\u5408\u540c\u3001\u623f\u4ea7\u8bc1\u590d\u5370\u4ef6\uff09\u3002 *   \u7ecf\u8425\u8303\u56f4\uff08\u9700\u5bf9\u7167\u6700\u65b0\u56fd\u6c11\u7ecf\u6d4e\u884c\u4e1a\u5206\u7c7b\u6807\u51c6\uff09\u3002</p>"},{"location":"#3","title":"3. \u5b98\u65b9\u5ba1\u6838\u4e0e\u201c\u6267\u7167\u5236\u4f5c\u201d","text":"<p>\u5e02\u573a\u76d1\u7ba1\u5c40\u5bf9\u63d0\u4ea4\u7684\u7535\u5b50\u6216\u7eb8\u8d28\u6750\u6599\u8fdb\u884c\u5408\u89c4\u6027\u5ba1\u67e5\u3002\u5ba1\u6838\u901a\u8fc7\u540e\uff0c\u767b\u8bb0\u7cfb\u7edf\u4f1a\u81ea\u52a8\u751f\u6210\u552f\u4e00\u7684\u7edf\u4e00\u793e\u4f1a\u4fe1\u7528\u4ee3\u7801\uff0c\u5e76\u7531\u5b98\u65b9\u7684\u7279\u5236\u6253\u5370\u673a\u5728\u4e13\u7528\u7684\u9632\u4f2a\u7eb8\u5f20\u4e0a\u5b8c\u6210\u8425\u4e1a\u6267\u7167\u5236\u4f5c\u4e0e\u6253\u5370\uff0c\u52a0\u76d6\u5e02\u573a\u76d1\u7763\u7ba1\u7406\u5c40\u5370\u7ae0\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u73b0\u4ee3\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u7684\u6837\u5f0f\u4e0e\u9632\u4f2a\u7279\u5f81","text":"<p>\u5728\u8c37\u6b4c\u56fe\u7247\u6216\u767e\u5ea6\u56fe\u7247\u4e2d\uff0c\u8425\u4e1a\u6267\u7167\u6837\u672c\u548c\u6700\u65b0\u6267\u7167\u6837\u5f0f\u662f\u4f01\u4e1a\u4e3b\u9891\u7e41\u68c0\u7d22\u7684\u91cd\u70b9\u3002\u81ea\u56fd\u5bb6\u63a8\u8fdb\u5546\u4e8b\u5236\u5ea6\u6539\u9769\u4ee5\u6765\uff0c\u73b0\u884c\u8425\u4e1a\u6267\u7167\u5177\u5907\u4ee5\u4e0b\u663e\u8457\u7279\u5f81\uff1a</p> <ul> <li>\u7248\u5f0f\u7ed3\u6784\uff1a \u7edf\u4e00\u8c03\u6574\u4e3a\u6b63\u672c\u548c\u526f\u672c\u4e24\u79cd\u3002\u6b63\u672c\u4e3a\u60ac\u6302\u7248\uff0c\u526f\u672c\u4e3a\u6298\u9875\u4e66\u672c\u7248\uff0c\u4e24\u8005\u5177\u6709\u540c\u7b49\u6cd5\u5f8b\u6548\u529b\u3002</li> <li>\u6838\u5fc3\u767b\u8bb0\u8981\u7d20\uff1a \u6267\u7167\u6b63\u9762\u660e\u786e\u8bb0\u8f7d\u4e86\u7edf\u4e00\u793e\u4f1a\u4fe1\u7528\u4ee3\u7801\u3001\u540d\u79f0\u3001\u7c7b\u578b\u3001\u6cd5\u5b9a\u4ee3\u8868\u4eba\u3001\u7ecf\u8425\u8303\u56f4\u3001\u6ce8\u518c\u8d44\u672c\u3001\u6210\u7acb\u65e5\u671f\u3001\u4f4f\u6240\u7b49\u5173\u952e\u4fe1\u606f\u3002</li> <li>\u4e8c\u7ef4\u7801\u6570\u5b57\u5316\u6838\u9a8c\uff1a \u6267\u7167\u6b63\u53f3\u4e0a\u89d2\u5e26\u6709\u5b98\u65b9\u4e8c\u7ef4\u7801\u3002\u4efb\u4f55\u673a\u6784\u6216\u4e2a\u4eba\u53ea\u9700\u4f7f\u7528\u624b\u673a\u626b\u63cf\u8be5\u4e8c\u7ef4\u7801\uff0c\u5373\u53ef\u76f4\u63a5\u8fde\u63a5\u81f3\u56fd\u5bb6\u4f01\u4e1a\u4fe1\u7528\u4fe1\u606f\u516c\u793a\u7cfb\u7edf\uff0c\u5b9e\u65f6\u67e5\u8be2\u8be5\u4f01\u4e1a\u7684\u6700\u65b0\u7ecf\u8425\u72b6\u6001\uff08\u5982\u662f\u5426\u6b63\u5e38\u7ecf\u8425\u3001\u662f\u5426\u6709\u5f02\u5e38\u540d\u5f55\u7b49\uff09\u3002</li> </ul>"},{"location":"#_4","title":"\u4e09\u3001 \u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u4ee3\u529e\u65b9\u5f0f\u89e3\u6790","text":"<p>\u5bf9\u4e8e\u7f3a\u4e4f\u653f\u52a1\u529e\u4e8b\u7ecf\u9a8c\u3001\u6216\u5e0c\u671b\u4e13\u6ce8\u4e8e\u6838\u5fc3\u4e1a\u52a1\u7684\u521b\u4e1a\u8005\u6765\u8bf4\uff0c\u9009\u62e9\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u4ee3\u529e\u65b9\u5f0f\u662f\u4e00\u79cd\u9ad8\u6548\u7684\u89e3\u51b3\u65b9\u6848\u3002\u5e38\u89c1\u7684\u5408\u89c4\u4ee3\u529e\u9014\u5f84\u5305\u62ec\uff1a</p>"},{"location":"#1_1","title":"1. \u59d4\u6258\u6b63\u89c4\u5de5\u5546\u8d22\u7a0e\u4ee3\u7406\u673a\u6784","text":"<p>\u8fd9\u662f\u76ee\u524d\u6700\u4e3b\u6d41\u7684\u4ee3\u529e\u65b9\u5f0f\u3002\u6b63\u89c4\u7684\u4ee3\u529e\u673a\u6784\u901a\u5e38\u62e5\u6709\u4e30\u5bcc\u7684\u884c\u4e1a\u7ecf\u9a8c\uff0c\u719f\u6089\u5404\u533a\u57df\u7684\u7a0e\u6536\u4f18\u60e0\u653f\u7b56\u548c\u7ecf\u8425\u8303\u56f4\u6838\u5b9a\u8981\u6c42\u3002 *   \u64cd\u4f5c\u6d41\u7a0b\uff1a \u521b\u4e1a\u8005\u53ea\u9700\u63d0\u4f9b\u8eab\u4efd\u8bc1\u4ef6\u548c\u57fa\u7840\u516c\u53f8\u4fe1\u606f\uff0c\u4e0e\u4ee3\u7406\u673a\u6784\u7b7e\u7f72\u300a\u59d4\u6258\u4ee3\u7406\u534f\u8bae\u300b\uff0c\u540e\u7eed\u7684\u540d\u79f0\u6838\u51c6\u3001\u6750\u6599\u64b0\u5199\u3001\u7a97\u53e3\u9012\u4ea4\u3001\u6267\u7167\u9886\u53d6\u7b49\u5747\u7531\u4ee3\u529e\u4eba\u5458\u5168\u7a0b\u8dd1\u817f\u3002 *   \u589e\u503c\u670d\u52a1\uff1a \u8fd9\u7c7b\u673a\u6784\u901a\u5e38\u8fd8\u80fd\u4e00\u4f53\u5316\u63d0\u4f9b\u4ee3\u7406\u8bb0\u8d26\u3001\u94f6\u884c\u5f00\u6237\u4ee3\u529e\u3001\u5370\u7ae0\u523b\u5236\u7b49\u540e\u7eed\u670d\u52a1\u3002</p>"},{"location":"#2_1","title":"2. \u4f7f\u7528\u94f6\u884c\u201c\u5de5\u5546\u4fbf\u6c11\u901a\u201d\u7b49\u653f\u52a1\u5408\u4f5c\u6e20\u9053","text":"<p>\u73b0\u5728\u8bb8\u591a\u5546\u4e1a\u94f6\u884c\u4e0e\u5e02\u573a\u76d1\u7ba1\u5c40\u5f00\u5c55\u4e86\u201c\u653f\u94f6\u5408\u4f5c\u201d\u3002\u521b\u4e1a\u8005\u5728\u6307\u5b9a\u94f6\u884c\u7f51\u70b9\u7533\u8bf7\u5f00\u6237\u7684\u540c\u65f6\uff0c\u53ef\u901a\u8fc7\u94f6\u884c\u7684\u7eff\u8272\u901a\u9053\u514d\u8d39\u4ee3\u529e\u8425\u4e1a\u6267\u7167\uff0c\u5b9e\u73b0\u201c\u4e00\u7ad9\u5f0f\u201d\u529e\u7ed3\u3002</p>"},{"location":"#_5","title":"\u56db\u3001 \u6570\u5b57\u5316\u5229\u5668\uff1a\u7535\u5b50\u8425\u4e1a\u6267\u7167\u7684\u666e\u9002\u5e94\u7528","text":"<p>\u5728\u5b8c\u6210\u7eb8\u8d28\u6267\u7167\u5236\u4f5c\u540e\uff0c\u56fd\u5bb6\u7cfb\u7edf\u4f1a\u81ea\u52a8\u540c\u6b65\u751f\u6210\u7535\u5b50\u8425\u4e1a\u6267\u7167\u3002</p> <ul> <li>\u5982\u4f55\u7533\u9886\uff1a \u4f01\u4e1a\u6cd5\u5b9a\u4ee3\u8868\u4eba\u53ef\u901a\u8fc7\u5fae\u4fe1\u6216\u652f\u4ed8\u5b9d\u7684\u201c\u7535\u5b50\u8425\u4e1a\u6267\u7167\u201d\u5c0f\u7a0b\u5e8f\uff0c\u7ecf\u8fc7\u5b9e\u540d\u5b9e\u4eba\u8ba4\u8bc1\u540e\u4e0b\u8f7d\u5230\u624b\u673a\u4e2d\u3002</li> <li>\u5e94\u7528\u573a\u666f\uff1a \u7535\u5b50\u8425\u4e1a\u6267\u7167\u4e0e\u7eb8\u8d28\u6267\u7167\u5177\u6709\u540c\u7b49\u6cd5\u5f8b\u6548\u529b\u3002\u5728\u529e\u7406\u7a0e\u52a1\u767b\u8bb0\u3001\u793e\u4fdd\u5f00\u6237\u3001\u516c\u79ef\u91d1\u7f34\u5b58\u3001\u751a\u81f3\u662f\u53c2\u4e0e\u62db\u6295\u6807\u65f6\uff0c\u76f4\u63a5\u51fa\u793a\u7535\u5b50\u8425\u4e1a\u6267\u7167\u4eae\u7167\u6216\u8fdb\u884c\u7535\u5b50\u7b7e\u540d\uff0c\u5373\u53ef\u5b8c\u6210\u5408\u89c4\u6821\u9a8c\uff0c\u6781\u5927\u5730\u964d\u4f4e\u4e86\u4f01\u4e1a\u7684\u529e\u4e8b\u6210\u672c\u3002</li> </ul>"},{"location":"#_6","title":"\u4e94\u3001 \u603b\u7ed3\u4e0e\u5408\u89c4\u98ce\u9669\u63d0\u793a","text":"<p>\u5408\u89c4\u83b7\u53d6\u6267\u7167\u662f\u4f01\u4e1a\u8bda\u4fe1\u7ecf\u8425\u7684\u7b2c\u4e00\u6b65\u3002\u4e0d\u8bba\u662f\u9009\u62e9\u81ea\u4e3b\u7533\u62a5\u8fd8\u662f\u5bfb\u627e\u4ee3\u529e\uff0c\u90fd\u5fc5\u987b\u786e\u4fdd\u6240\u6709\u6ce8\u518c\u6750\u6599\u7684\u771f\u5b9e\u6027\u3002</p> <p>\u4e25\u6b63\u6cd5\u5f8b\u58f0\u660e\uff1a \u8425\u4e1a\u6267\u7167\u662f\u56fd\u5bb6\u673a\u5173\u9881\u53d1\u7684\u6cd5\u5b9a\u8bc1\u4ef6\u3002\u4efb\u4f55\u79c1\u81ea\u4f2a\u9020\u3001\u53d8\u9020\u3001\u4e70\u5356\u6216\u4f7f\u7528\u5047\u5192\u8425\u4e1a\u6267\u7167\u7684\u884c\u4e3a\uff0c\u5747\u89e6\u72af\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u5211\u6cd5\u300b\u7b2c\u4e8c\u767e\u516b\u5341\u6761\uff0c\u6d89\u5acc\u6784\u6210\u201c\u4f2a\u9020\u3001\u53d8\u9020\u3001\u4e70\u5356\u56fd\u5bb6\u673a\u5173\u516c\u6587\u3001\u8bc1\u4ef6\u3001\u5370\u7ae0\u7f6a\u201d\u3002\u5404\u7ea7\u653f\u5e9c\u90e8\u95e8\u3001\u7535\u5546\u5e73\u53f0\u3001\u94f6\u884c\u5728\u5ba1\u67e5\u4f01\u4e1a\u8d44\u8d28\u65f6\uff0c\u5747\u4f1a\u901a\u8fc7\u516c\u793a\u7cfb\u7edf\u8054\u7f51\u6838\u67e5\uff0c\u5207\u52ff\u76f8\u4fe1\u6240\u8c13\u7684\u201c\u514d\u6750\u6599\u5feb\u901f\u51fa\u7167\u201d\u7b49\u8fdd\u6cd5\u5c0f\u5e7f\u544a\uff0c\u4ee5\u514d\u7ed9\u81ea\u5df1\u5e26\u6765\u4e25\u91cd\u7684\u6cd5\u5f8b\u98ce\u9669\u3002</p>"}]}